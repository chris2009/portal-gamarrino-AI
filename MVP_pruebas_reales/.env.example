# Copia este archivo como .env para probar en la PC. En Hugging Face no se usa
# .env: estas mismas variables van en Settings > "Variables and secrets" del Space.

OPENAI_API_KEY=sk-...

# Cadena de conexión de Supabase (Connect > "Session pooler" o "Transaction pooler").
# Si se deja vacía, el historial se guarda en historial.db (SQLite local).
DATABASE_URL=postgresql://postgres.xxxxxxxx:CONTRASEÑA@aws-0-xx.pooler.supabase.com:6543/postgres

# Contraseña que se les da a los probadores. Si se deja vacía, no se pide.
APP_PASSWORD=

# LangSmith: trazas de cada conversación (el aviso de privacidad de la app lo dice).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=portal-gamarrino-pruebas-reales
